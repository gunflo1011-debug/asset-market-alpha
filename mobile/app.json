{
  "expo": {
    "name": "Things",
    "slug": "things",
    "scheme": [
      "things",
      "thingsalpha"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Things to use your camera to scan product barcodes and QR codes."
        }
      ]
    ],
    "android": {
      "package": "com.gunflo1011.things",
      "softwareKeyboardLayoutMode": "resize"
    },
    "androidStatusBar": {
      "backgroundColor": "#FFFFFF",
      "barStyle": "dark-content"
    },
    "androidNavigationBar": {
      "backgroundColor": "#FFFFFF",
      "barStyle": "dark-content"
    },
    "splash": {
      "backgroundColor": "#FFFFFF"
    }
  }
}
